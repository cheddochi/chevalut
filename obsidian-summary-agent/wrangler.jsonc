{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obsidian-summary-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // 프론트엔드 정적 파일(목록/토폴로지 화면) 서빙
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // 읽기(기존 notes 테이블 조회)와 쓰기(분석 결과 summary_* 테이블 저장)를
  // 모두 같은 Hyperdrive 연결 하나로 처리한다. 별도 D1/KV 등 저장소는 두지 않는다.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d57e6622b4d843859f4adccf40a9135d"
    }
  ],

  // 문장 파싱 + 태그/카테고리 생성에 사용하는 Workers AI
  "ai": {
    "binding": "AI"
  },

  "vars": {
    "VAULT_NOTES_TABLE": "notes"
  }
}
