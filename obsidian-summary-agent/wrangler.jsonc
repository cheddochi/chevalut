{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obsidian-summary-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // 프론트엔드 정적 파일(목록/토폴로지 화면) 서빙
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // 옵시디언 볼트 md 원본이 실제로 동기화되는 R2 버킷 (읽기 전용으로 사용)
  "r2_buckets": [
    {
      "binding": "VAULT_BUCKET",
      "bucket_name": "chevault"
    }
  ],

  // 분석 결과(summary_* 테이블) 저장 전용. 원본 md는 R2에만 있고 Postgres에 복제하지 않는다.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d57e6622b4d843859f4adccf40a9135d"
    }
  ],

  // 문장 파싱 + 태그/카테고리 생성에 사용하는 Workers AI
  "ai": {
    "binding": "AI"
  },

  "vars": {
    // R2 버킷 안에서 옵시디언 볼트가 시작되는 접두사
    "VAULT_PREFIX": "vault/"
  },

  // 10분마다 미분석/변경된 노트를 자동으로 이어서 처리한다.
  // Workers AI 일일 무료 할당량을 다 쓴 날에도, 리셋되는 순간부터 사람이 버튼을 누르지 않아도
  // 자동으로 나머지 백필이 재개된다. 처리할 게 없으면 가벼운 조회만 하고 끝난다.
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
