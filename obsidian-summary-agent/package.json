  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  }
}
